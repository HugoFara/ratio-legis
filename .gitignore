__pycache__/
*.pyc
*.egg-info/
.venv/

# `travail/` est un cache de construction, pas une source. Il est reconstruit en
# entier par `pipeline.sh` : le fonds LEGI depuis le miroir DILA, les rapports
# depuis `data/corpus/plan-rapports.tsv`, la base depuis les deux. Rien de ce
# qu'il contient n'est un original.
#
# Le versionner avait deux conséquences, l'une gênante et l'autre inacceptable :
# 775,8 Mo sur 777,4 Mo de dépôt pour du dérivé, et surtout la rediffusion des
# 419 fichiers de rapports parlementaires que `ATTRIBUTION.md` déclare ne pas
# versionner, faute de régime de réutilisation confirmé par les deux chambres.
travail/

# Le dump ouvert est un artefact reproductible : `tools/diffusion/dump.py` le
# refait d'une commande. Seuls son manifeste haché et sa notice sont versionnés,
# comme pour les miroirs DILA et EUR-Lex.
data/diffusion/*.sqlite
data/diffusion/tsv/

# Verrous d'écriture de `tools/mesures/juger.py` : un fichier vide par fiche
# ouverte, sans contenu à conserver.
data/mesures/.*.verrou
